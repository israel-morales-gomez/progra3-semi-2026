# Copia este archivo a .env y ajusta los valores.
# Los valores marcados con CAMBIAR son SOLO para desarrollo: en produccion
# (ENTORNO=produccion) el sistema se niega a arrancar si siguen asi.

ENTORNO=desarrollo

# Conexion PostgreSQL nativa. Si la clave tiene caracteres especiales (@ : / #)
# debe ir codificada en URL (ej. @ = %40).
DATABASE_URL=postgresql+psycopg://postgres:(la_contrasena)@localhost:5432/omega

# JWT (minimo 32 caracteres). Generar: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR-N_VqxMcYF2d7bN1pYlW-CyZ9aflzp52lzxUw07dBt8qpnArrS5gC0lXGGkA16q2z
JWT_ALGORITMO=HS256
ACCESS_TOKEN_MINUTOS=15
OMEGA_TOKEN_MINUTOS=10
REFRESH_TOKEN_DIAS=7

# Clave Fernet para cifrar campos sensibles (secreto TOTP). Generar:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_CAMPOS=URyQdj415VryvSTkmZl1sSxkBDi2y1lMFmp1ecimPP8=

# CORS: origenes separados por coma. Vacio = CORS deshabilitado.
CORS_ORIGENES=

# Redes/IPs autorizadas para el login del Administrador Omega (CIDR, separadas por coma).
# En produccion: el rango de la VPN del MINSAL/Gobierno.
OMEGA_IPS_PERMITIDAS=127.0.0.1/32,::1/128

# Tipos de institucion que exigen 2FA por codigo (simulado en consola).
TWOFA_TIPOS=HOSPITAL,LABORATORIO
TWOFA_MINUTOS=5

# Rate limiting de login
LOGIN_MAX_POR_IP=10
LOGIN_MAX_FALLOS_ID=8
LOGIN_VENTANA_SEG=60
LOGIN_BLOQUEO_SEG=900

# true = valida el digito verificador del DUI (modulo 10). false = solo formato.
DUI_VALIDAR_DIGITO=false

HSTS_ACTIVO=false
DOCS_ACTIVOS=true


# --- Etapa 2: núcleo clínico ---
MEDICINA_LEGAL_SECRET=CAMBIAR-A3Oy0R0mEnp7eztlEjOxUOK1r4SXEGc7qohLdjbEgLSnlpYTjbq5Yg
MEDICINA_LEGAL_IPS=
MEDICINA_LEGAL_VENTANA_SEG=300
BYPASS_REVISION_HORAS=48
EXPEDIENTE_MAX_LECTURAS_MIN=120